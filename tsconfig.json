{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["agents/**/*.ts", "api/**/*.ts", "crm/**/*.ts", "integrations/**/*.ts", "memory/**/*.ts", "skills/**/*.ts", "src/**/*.ts", "tools/**/*.ts", "tests/**/*.ts"]
}
